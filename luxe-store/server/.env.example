# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB Atlas connection string.
# In Atlas: Database > Connect > Drivers > copy the "mongodb+srv://..." URI,
# then replace <username>, <password>, and add a database name before the "?".
# Example:
# MONGODB_URI=mongodb+srv://luxeAdmin:yourpassword@cluster0.abcde.mongodb.net/luxe-store?retryWrites=true&w=majority
MONGODB_URI=

# Port the Express API runs on
PORT=5000

# Origin allowed to call this API (your Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWT). Use any long random string —
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
